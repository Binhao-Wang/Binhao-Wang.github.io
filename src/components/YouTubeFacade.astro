---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

// Click-to-play YouTube embed. Until clicked it shows a self-hosted thumbnail, so the page makes no requests
// to Google. Without JavaScript the thumbnail is a plain link to the video on YouTube.
interface Props {
  id: string;
  title: string;
  thumbnail: ImageMetadata;
  caption?: string;
  credit?: string;
  eager?: boolean;
}

const { id, title, thumbnail, caption, credit, eager = false } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
---

<figure class="media-movie yt-facade">
  <div class="media-movie-frame">
    <a class="yt-link" href={watchUrl} rel="external" data-yt-id={id} data-yt-title={title} aria-label={"Play video: " + title}>
      <Picture
        src={thumbnail}
        alt={"Video thumbnail: " + title}
        formats={["avif", "webp"]}
        widths={[480, 800, thumbnail.width]}
        sizes="(max-width: 900px) 100vw, 50vw"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
      <span class="yt-play" aria-hidden="true"></span>
    </a>
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && <span class="media-movie-credit"> Credit: {credit}.</span>}
      <a class="media-movie-more" href={watchUrl} rel="external">Watch on YouTube</a>
    </figcaption>
  )}
</figure>

<script>
  // Swap the thumbnail for the privacy-enhanced player on click (or Enter/Space).
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-yt-id]")) {
    link.setAttribute("role", "button");
    const play = (event: Event) => {
      event.preventDefault();
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.ytId}?autoplay=1`;
      frame.title = link.dataset.ytTitle ?? "YouTube video";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      link.replaceWith(frame);
      frame.focus();
    };
    link.addEventListener("click", play);
    link.addEventListener("keydown", (event) => event.key === " " && play(event));
  }
</script>
