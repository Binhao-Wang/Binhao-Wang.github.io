---
import type { PublicationStatus } from "../data/publications.manual";
import type { ResearchStatus } from "../data/research";

interface Props {
  status: PublicationStatus | ResearchStatus;
}

const { status } = Astro.props;
const statusClass = status.toLowerCase().replaceAll(" ", "-");
---

<span class={"status-tag status-" + statusClass}>{status}</span>
