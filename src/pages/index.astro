---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroFeature from "../components/HeroFeature.astro";
import MediaFrame from "../components/MediaFrame.astro";
import NewsList from "../components/NewsList.astro";
import ResearchCard from "../components/ResearchCard.astro";
import AuthorList from "../components/AuthorList.astro";
import { news } from "../data/news";
import { publications } from "../data/publications";
import { researchStories } from "../data/research";
import { profile } from "../data/site";

const selectedPapers = publications.filter((publication) => publication.featured);
---

<BaseLayout title={profile.name}>
  <section class="home-hero">
    <div class="site-shell hero-grid">
      <div class="hero-copy">
        <div class="hero-id">
          <MediaFrame photo={profile.portrait} kind="avatar" label={profile.name} class="hero-portrait" eager={true} />
          <div>
            <h1 class="hero-name">{profile.name}</h1>
            <p class="hero-role">{profile.position}</p>
            <p class="hero-affiliation">{profile.affiliation}</p>
          </div>
        </div>
        <p class="hero-identity-line">I build <em>physics-based earthquake forecasts</em>.</p>
        <p class="hero-description">{profile.heroLine}</p>
        <div class="hero-actions">
          <a class="button button-ink" href="/research">Research</a>
          <a class="button button-outline" href="/publications">Publications</a>
          <a class="button button-outline" href={profile.links.scholar} rel="external">Scholar</a>
          <a class="button button-outline" href="/cv">CV</a>
          {profile.email && <a class="button button-outline" href={"mailto:" + profile.email}>Email</a>}
        </div>
      </div>

      <div class="hero-art">
        <HeroFeature />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="site-shell about-grid">
      <div>
        <h2 class="section-heading">About</h2>
      </div>
      <div class="about-copy">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
        <div class="about-lists">
          <div>
            <h3>Questions I chase</h3>
            <ul>{profile.questions.map((question) => <li>{question}</li>)}</ul>
          </div>
          <div>
            <h3>Interests</h3>
            <ul class="tag-list">{profile.interests.map((interest) => <li>{interest}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <div class="section-topline">
        <h2 class="section-heading">Research</h2>
        <a class="section-link" href="/research">All chapters</a>
      </div>

      <div class="chapter-grid">
        {researchStories.map((story, index) => <ResearchCard story={story} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="site-shell">
      <div class="section-topline">
        <h2 class="section-heading">News</h2>
        <a class="section-link" href="/news">All news</a>
      </div>
      <NewsList items={news.slice(0, 4)} />
    </div>
  </section>

  <section class="section-tight">
    <div class="site-shell">
      <div class="section-topline">
        <h2 class="section-heading">Recent papers</h2>
        <a class="section-link" href="/publications">All publications</a>
      </div>
      <ol class="selected-papers">
        {selectedPapers.map((paper) => (
          <li>
            <span class="selected-year">{paper.year}</span>
            <div>
              <p class="selected-title">
                {paper.url ? <a href={paper.url} rel="external">{paper.title}</a> : paper.title}
              </p>
              <p class="selected-meta"><AuthorList authors={paper.authors} /></p>
              <p class="selected-venue">{paper.venue}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
