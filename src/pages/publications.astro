---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthorList from "../components/AuthorList.astro";
import ContactInvite from "../components/ContactInvite.astro";
import { publications } from "../data/publications";
import { profile } from "../data/site";
import type { PublicationStatus } from "../data/publications.manual";

const publicationGroups: { status: PublicationStatus; description: string }[] = [
  {
    status: "Published",
    description: "Peer-reviewed publications"
  },
  {
    status: "Under review",
    description: "Submitted manuscripts"
  },
  {
    status: "In preparation",
    description: "Active research in development"
  }
];
---

<BaseLayout
  title="Publications"
  description="Publications and manuscripts by Binhao Wang in earthquake physics, rock rheology, and earthquake-cycle dynamics."
>
  <section class="site-shell page-hero publications-hero">
    <div>
      <p class="page-kicker">Publications</p>
      <h1 class="page-title">Papers and work in progress.</h1>
      <p class="page-dek">
        Peer-reviewed papers, manuscripts under review, and work in preparation, from laboratory friction and earthquake-cycle simulations to fault systems and repeating earthquakes.
      </p>
      <ContactInvite />
    </div>
    <aside class="page-aside">
      <strong><span class="nowrap">{publications.filter((p) => p.status === "Published").length} published</span> · <span class="nowrap">{publications.filter((p) => p.status === "Under review").length} under review</span> · <span class="nowrap">{publications.filter((p) => p.status === "In preparation").length} in preparation</span></strong>
      <p>See also <a href={profile.links.scholar} rel="external">Google Scholar</a>.</p>
    </aside>
  </section>

  <section class="section-tight">
    <div class="site-shell">
      <p class="publication-utility">DOI and preprint links open the canonical record.</p>

      {publicationGroups.map((group) => {
        const groupPublications = publications.filter((publication) => publication.status === group.status);
        if (groupPublications.length === 0) return null;
        return (
          <div class="publication-group">
            <div class="publication-group-heading">
              <div>
                <p class="publication-overline">{group.description}</p>
                <h2>{group.status}</h2>
              </div>
              <span>{groupPublications.length} items</span>
            </div>

            {groupPublications.length > 0 ? (
              <ol class="publication-list">
                {groupPublications.map((publication) => (
                  <li class="publication-item">
                    <span class="publication-year">{publication.status === "Published" ? publication.year : "—"}</span>
                    <div>
                      <h3 class="publication-title">{publication.title}</h3>
                      <p class="publication-authors"><AuthorList authors={publication.authors} /></p>
                      {publication.status === "Published" && <p class="publication-venue">{publication.venue}</p>}
                      {publication.note && <p class="publication-note">{publication.note}</p>}
                    </div>
                    {publication.url && (
                      <div class="publication-links">
                        <a href={publication.url} rel="external">
                          {publication.note ?? "DOI"}
                        </a>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            ) : (
              <p class="publication-empty">No records in this section yet.</p>
            )}
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
